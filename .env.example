# ─────────────────────────────────────────────────────────────────────────────
# .env.example — EXPORT Automation System
#
# This is a safe template file — copy it to .env and fill in real values.
# .env is listed in .gitignore and must NEVER be committed to version control.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Gmail SMTP Credentials ────────────────────────────────────────────────────
#
# The Gmail account that will send all outreach emails.
# Must have 2-Step Verification enabled on the Google account.
#
# How to generate an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable "2-Step Verification" if not already active
#   3. Search for "App Passwords" → select "Mail" → Generate
#   4. Paste the 16-character code below (spaces are optional)
#
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx


# ── CC / Monitoring Address (optional) ───────────────────────────────────────
#
# Every sent email will be silently CC'd to this address.
# Useful for a shared inbox or personal monitoring copy.
# Leave blank to disable CC.
#
CC_EMAIL=


# ── Google Gemini AI API Key ──────────────────────────────────────────────────
#
# Used for AI-based email classification (business vs. individual).
# Get your free API key from: https://aistudio.google.com/app/apikey
#
GEMINI_API_KEY=AIzaSy_your_key_here


# ── Search & Run Configuration ────────────────────────────────────────────────
#
# SEARCH_KEYWORD      — Primary buyer search term (used across all 5 adapters)
# DAILY_SEND_LIMIT    — Max emails sent per run (Gmail free: ~500/day max)
# SEND_DELAY_SECONDS  — Pause between each send; min 2s to avoid throttling
# MAX_RESULTS_PER_SOURCE — Cap on records fetched from each search adapter
#
SEARCH_KEYWORD=Singing Bowls
DAILY_SEND_LIMIT=100
SEND_DELAY_SECONDS=2
MAX_RESULTS_PER_SOURCE=20


# ── Presentation / Attachment File ───────────────────────────────────────────
#
# Path to the PDF or PPTX that will be attached to every outreach email.
# Place your file in the assets/ directory and update this path if needed.
# Leave as-is if you use the default filename.
#
PRESENTATION_PATH=assets/company_presentation.pdf
SCRAPINGBEE_API_KEY=xxxxxxxxxxxxx
